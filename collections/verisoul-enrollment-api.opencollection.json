{
  "opencollection": "1.0.0",
  "info": {
    "name": "Verisoul Account Enrollment API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Enrollment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Enroll Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.verisoul.ai/liveness/enroll",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enrolls an account in Face Match system using the provided session ID and account ID. Sessions must be enrolled within 30 days of creation."
        }
      ]
    }
  ],
  "bundled": true
}